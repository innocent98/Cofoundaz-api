# =============================================================================
# cofoundaz-api - PRODUCTION environment template
# =============================================================================
#
#   cp .env.production.example .env.production
#   chmod 600 .env.production          # it holds the database password
#
# .env.production is gitignored and MUST stay that way. It lives only on the VPS
# at ${DEPLOY_PATH}/.env.production, owned by the deploy user, mode 0600.
#
# Consumed by:  docker compose -f docker-compose.prod.yml --env-file .env.production
#
# Two kinds of variable live here:
#   (a) read by the application  (Pydantic Settings, app/core/config.py)
#   (b) read by compose itself   (image tag, resource sizing, Postgres tuning)
# Both are marked below.
#
# NOTE: DATABASE_URL and REDIS_URL are NOT set here. docker-compose.prod.yml
# builds them from POSTGRES_* and injects them via `environment:`, which takes
# precedence over env_file. Setting them here would be misleading - the value
# would be silently ignored.

# -----------------------------------------------------------------------------
# 1. SECRETS - generate fresh, never copy from another environment  [app]
# -----------------------------------------------------------------------------

# Signs every access/refresh JWT.
#   openssl rand -hex 32
# DANGER: rotating this invalidates every issued token - all users are logged
# out immediately. That is survivable and is the correct response to a suspected
# leak. Rotate on a schedule you choose, not by accident.
SECRET_KEY=CHANGE_ME__openssl_rand_hex_32

# Fernet key encrypting stored TOTP secrets at rest (app/services/auth/mfa.py).
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# *** DANGER - READ BEFORE CHANGING ***
# This key is NOT rotatable in place. Every MFA secret in the database is
# encrypted with it. Change it and every MFA-enrolled user is permanently locked
# out of their account - they cannot generate a valid TOTP code and cannot log in
# to disable MFA. Recovery means an operator resetting MFA per user in the DB.
# Back this key up somewhere you will still have it after the VPS is gone.
MFA_ENCRYPTION_KEY=CHANGE_ME__Fernet_generate_key

# Postgres superuser for this stack. Used by compose to build DATABASE_URL and
# to initialise the data volume.
#   openssl rand -base64 32 | tr -d '/+=' | head -c 40
# DANGER: POSTGRES_PASSWORD is only read on FIRST start, when initdb creates the
# data directory. Changing it later does NOT change the database password - the
# app will simply fail to authenticate. To rotate, ALTER USER inside Postgres and
# update this file together.                                        [compose]
POSTGRES_USER=cofoundaz
POSTGRES_PASSWORD=CHANGE_ME__strong_random_password
POSTGRES_DB=cofoundaz

# Bootstrap admin account.                                              [app]
# Use a real mailbox you control; this is the account that recovers the others.
FIRST_SUPERUSER_EMAIL=admin@yourdomain.com
FIRST_SUPERUSER_PASSWORD=CHANGE_ME__strong_random_password

# -----------------------------------------------------------------------------
# 2. APPLICATION                                                        [app]
# -----------------------------------------------------------------------------
PROJECT_NAME=cofoundaz-api
VERSION=0.1.0
API_V1_STR=/api/v1

# Must be `production`. This is not cosmetic: app/core/logger.py drops the log
# level from DEBUG to INFO on any value other than `development`, and DEBUG logs
# request detail you do not want retained in production.
ENVIRONMENT=production

# Public origin, used to build links in outbound email (verification, password
# reset). Wrong value here = every emailed link points at the wrong host.
SERVER_HOST=https://api.yourdomain.com
SERVER_PORT=8000

# Frontend app origin, used to build deep links in notification emails
# (app/worker/handlers/email.py `deep_link`). This is the USER-FACING WEB app,
# not the API. Falls back to SERVER_HOST when empty - but SERVER_HOST is the API
# origin, so a notification "Open" button would point at the backend. Set this to
# the web origin so those links land in the app.
APP_BASE_URL=https://app.yourdomain.com

# Empty = log to stderr only, so Docker's json-file driver collects and rotates.
# Leave it empty. A path here writes logs inside the container, where they are
# invisible to `docker logs` and lost on every deploy.
LOG_FILE_PATH=

# -----------------------------------------------------------------------------
# 3. AUTH / SESSION POSTURE                                             [app]
# -----------------------------------------------------------------------------
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_COOKIE_NAME=cfz_refresh

# MUST be True in production. False sends the refresh cookie over plain HTTP,
# where any network hop can read it and replay a 30-day session.
REFRESH_COOKIE_SECURE=True

# `lax` is correct when the frontend is on the same site as the API.
# If the frontend is on a DIFFERENT origin, this must be `none` - and `none`
# requires REFRESH_COOKIE_SECURE=True or browsers reject the cookie outright.
REFRESH_COOKIE_SAMESITE=lax

LOGIN_MAX_FAILS=5
LOGIN_LOCKOUT_MINUTES=15

# -----------------------------------------------------------------------------
# 4. CORS                                                               [app]
# -----------------------------------------------------------------------------
# Exact origins only. The app sends allow_credentials=True, so a wildcard is
# both rejected by browsers and a credential-theft vector. No trailing slashes.
BACKEND_CORS_ORIGINS=["https://app.yourdomain.com","https://yourdomain.com"]

# -----------------------------------------------------------------------------
# 5. DATABASE POOL                                                      [app]
# -----------------------------------------------------------------------------
# Per gunicorn worker, NOT per container. Total possible connections:
#   WEB_CONCURRENCY x (DATABASE_POOL_SIZE + DATABASE_MAX_OVERFLOW)
#   = 4 x (5 + 5) = 40, against POSTGRES_MAX_CONNECTIONS=100.
# Raise either of these and you MUST re-check that arithmetic, or the API will
# start failing with "FATAL: sorry, too many clients already" under load.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5

# -----------------------------------------------------------------------------
# 6. RATE LIMITING                                                      [app]
# -----------------------------------------------------------------------------
# Applied per authenticated user, falling back to client IP (app/main.py).
# NOTE: this is enforced per API *process* using slowapi's in-memory storage, so
# the effective global limit is roughly this x WEB_CONCURRENCY. Treat it as
# defence-in-depth behind nginx's own limit_req, not as an exact quota.
RATE_LIMIT_PER_MINUTE=120

# -----------------------------------------------------------------------------
# 7. EMAIL                                                              [app]
# -----------------------------------------------------------------------------
# resend | smtp | console | file.  MUST be `resend` or `smtp` in production -
# `console` discards and `file` writes-to-disk verification, password-reset,
# invite and notification emails, so signup appears to work while no user can
# ever verify their address. All of those emails send through this one backend.
#
# RESEND (recommended). Get a key at https://resend.com and VERIFY YOUR SENDING
# DOMAIN there first: Resend rejects sends from an unverified domain, so
# EMAILS_FROM_EMAIL must be an address on a domain you have verified (not a
# `yourdomain.com` placeholder). The backend fails loud - a missing RESEND_API_KEY
# or EMAILS_FROM_EMAIL raises and breaks signup rather than silently dropping mail,
# which is deliberate for must-deliver transactional email.
EMAIL_BACKEND=resend
RESEND_API_KEY=re_CHANGE_ME
EMAILS_FROM_EMAIL=noreply@yourdomain.com   # MUST be on a Resend-verified domain
EMAILS_FROM_NAME=Cofoundaz

# SMTP alternative - set EMAIL_BACKEND=smtp and fill these instead of RESEND_API_KEY
# (EMAILS_FROM_EMAIL/NAME above are shared by both backends):
# SMTP_HOST=smtp.yourprovider.com
# SMTP_PORT=587
# SMTP_TLS=true
# SMTP_USER=CHANGE_ME
# SMTP_PASSWORD=CHANGE_ME

# -----------------------------------------------------------------------------
# 8. STORAGE                                                            [app]
# -----------------------------------------------------------------------------
STORAGE_BACKEND=local
# Backed by the `app_storage` named volume in docker-compose.prod.yml. The API
# container runs with a read-only root filesystem, so this path MUST stay inside
# a declared volume - anywhere else and uploads fail with EROFS.
LOCAL_STORAGE_DIR=./var/storage

# -----------------------------------------------------------------------------
# 8b. AI / LLM                                                          [app]
# -----------------------------------------------------------------------------
# Powers Module 03 (AI Co-Founder) and the deferred AI features it unblocks:
# Business Builder plan generator (§08.11), health-score narrative, mission reason
# lines, recommendation reasons, learning recommendations, validation insights.
# Provider-agnostic (the LLM seam switches on LLM_PROVIDER). An EMPTY LLM_API_KEY
# keeps the AI features disabled/stubbed; set it to turn them on.
#   openai    → LLM_MODEL=gpt-4o-mini,  LLM_BASE_URL blank (OpenAI default)
#   anthropic → LLM_MODEL=claude-3-5-sonnet-latest, LLM_BASE_URL blank
#   azure / gateway / self-hosted (OpenAI-compatible) → set LLM_BASE_URL to the endpoint
LLM_PROVIDER=openai
LLM_API_KEY=CHANGE_ME
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=

# =============================================================================
# 9. COMPOSE-ONLY - infrastructure sizing and deployment            [compose]
# =============================================================================

# --- WHICH STACK THIS IS. Read this section before copying the file. ---------
#
# This template serves BOTH environments (`cp .env.production.example .env.staging`
# is the documented way to start a staging file). One VPS runs both stacks, so
# three values MUST differ between them or the second stack cannot start:
#
#   variable               production            staging
#   ---------------------  --------------------  --------------------------
#   COMPOSE_PROJECT_NAME   cofoundaz-api-prod    cofoundaz-api-staging
#   API_PORT               8000                  8001
#   SERVER_HOST            https://api.cofoundaz.com
#                                                https://staging-api.cofoundaz.com
#
# Compose project name. It prefixes every container, network and NAMED VOLUME,
# so this is the single value that keeps the staging Postgres data directory
# from being the production one. Get it wrong and the second `compose up` adopts
# the first stack's containers; a later `down -v` then destroys the wrong
# database. There is no warning when this is wrong - both stacks just look fine
# until they don't.
COMPOSE_PROJECT_NAME=cofoundaz-api-prod

# Image to run. CD sets this to an immutable sha tag; `latest` is a fallback for
# a manual first deploy only. Never leave production pinned to `latest` - you
# cannot tell what is running or roll back to a known-good build.
API_IMAGE=ghcr.io/innocent98/cofoundaz-api:sha-CHANGEME

# Provenance baked into the image / surfaced by /api/v1/health/ready.
GIT_SHA=unknown
APP_VERSION=0.1.0

# Host port, bound to 127.0.0.1 by docker-compose.prod.yml; nginx proxies to it.
# MUST be 8001 on staging - two stacks cannot both bind 127.0.0.1:8000, and the
# failure is a bind error on whichever comes up second. The nginx vhosts in
# deploy/nginx/ hardcode this map: api.cofoundaz.com -> 8000,
# staging-api.cofoundaz.com -> 8001.
API_PORT=8000

# Which peer addresses gunicorn/uvicorn will believe X-Forwarded-For and
# X-Forwarded-Proto from. Gunicorn reads this env var natively
# (gunicorn.config.ForwardedAllowIPS: `os.environ.get("FORWARDED_ALLOW_IPS",
# "127.0.0.1,::1")`), so setting it here needs no command-line flag and no
# application code change.
#
# WITHOUT IT THE APP'S RATE LIMITER IS EFFECTIVELY OFF FOR ANONYMOUS TRAFFIC.
# nginx connects to 127.0.0.1:${API_PORT}, but Docker opens a SECOND connection
# into the container from the compose bridge gateway, so the peer address
# uvicorn sees is 172.x.0.1 and the "127.0.0.1" default never matches.
# ProxyHeadersMiddleware then declines to rewrite the client, every
# unauthenticated request keys on that one gateway address, and login, signup
# and forgot-password share a single 120/minute bucket for the entire internet.
# Verified by observation, not inference - see the SOP.
#
# WHY `*` AND NOT A NARROWER VALUE. Two narrower options were tried and both
# fail:
#   - A CIDR such as 172.16.0.0/12 is REJECTED BY GUNICORN. Its
#     `validate_string_to_addr_list` calls `ipaddress.ip_address()` on each
#     entry, which raises on a network. The container crash-loops with
#     "Error: '172.16.0.0/12' does not appear to be an IPv4 or IPv6 address".
#     (uvicorn's own _TrustedHosts does accept CIDR - gunicorn never lets the
#     value reach it.)
#   - A literal gateway address works but is not stable: Docker allocates the
#     bridge subnet from a pool at network-creation time, so it can change on
#     any `compose down` / `up`, and it differs between the two stacks.
#
# WHAT MAKES `*` SAFE HERE. Two things, and both must stay true:
#   1. The port is published on 127.0.0.1 only, so nothing off-host can reach
#      the app to forge a header in the first place.
#   2. nginx OVERWRITES X-Forwarded-For with $remote_addr instead of appending
#      to a client-supplied one. This is the real control: with `*`, uvicorn
#      takes the LEFTMOST value, so an appended header would let any client
#      choose its own rate-limit identity. See
#      deploy/nginx/snippets/proxy-backend.conf and docs/deployment/NGINX_TLS.md.
FORWARDED_ALLOW_IPS=*

# gunicorn worker count. Baseline is 4 for a 4 vCPU VPS. See the connection
# arithmetic in section 5 before changing.
WEB_CONCURRENCY=4

# --- Postgres tuning. Sized for the db service's 3072M limit. -----------------
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_SHARED_BUFFERS=768MB
POSTGRES_EFFECTIVE_CACHE_SIZE=2GB
POSTGRES_WORK_MEM=8MB
POSTGRES_MAINTENANCE_WORK_MEM=256MB

# --- Redis --------------------------------------------------------------------
# Deliberately below the redis service's 512M limit so Redis evicts by policy
# before the kernel OOM-kills it.
REDIS_MAXMEMORY=384mb
