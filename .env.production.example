# =============================================================================
# cofoundaz-api - PRODUCTION environment template
# =============================================================================
#
#   cp .env.production.example .env.production
#   chmod 600 .env.production          # it holds the database password
#
# .env.production is gitignored and MUST stay that way. It lives only on the VPS
# at ${DEPLOY_PATH}/.env.production, owned by the deploy user, mode 0600.
#
# Consumed by:  docker compose -f docker-compose.prod.yml --env-file .env.production
#
# Two kinds of variable live here:
#   (a) read by the application  (Pydantic Settings, app/core/config.py)
#   (b) read by compose itself   (image tag, resource sizing, Postgres tuning)
# Both are marked below.
#
# NOTE: DATABASE_URL and REDIS_URL are NOT set here. docker-compose.prod.yml
# builds them from POSTGRES_* and injects them via `environment:`, which takes
# precedence over env_file. Setting them here would be misleading - the value
# would be silently ignored.

# -----------------------------------------------------------------------------
# 1. SECRETS - generate fresh, never copy from another environment  [app]
# -----------------------------------------------------------------------------

# Signs every access/refresh JWT.
#   openssl rand -hex 32
# DANGER: rotating this invalidates every issued token - all users are logged
# out immediately. That is survivable and is the correct response to a suspected
# leak. Rotate on a schedule you choose, not by accident.
SECRET_KEY=CHANGE_ME__openssl_rand_hex_32

# Fernet key encrypting stored TOTP secrets at rest (app/services/auth/mfa.py).
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# *** DANGER - READ BEFORE CHANGING ***
# This key is NOT rotatable in place. Every MFA secret in the database is
# encrypted with it. Change it and every MFA-enrolled user is permanently locked
# out of their account - they cannot generate a valid TOTP code and cannot log in
# to disable MFA. Recovery means an operator resetting MFA per user in the DB.
# Back this key up somewhere you will still have it after the VPS is gone.
MFA_ENCRYPTION_KEY=CHANGE_ME__Fernet_generate_key

# Postgres superuser for this stack. Used by compose to build DATABASE_URL and
# to initialise the data volume.
#   openssl rand -base64 32 | tr -d '/+=' | head -c 40
# DANGER: POSTGRES_PASSWORD is only read on FIRST start, when initdb creates the
# data directory. Changing it later does NOT change the database password - the
# app will simply fail to authenticate. To rotate, ALTER USER inside Postgres and
# update this file together.                                        [compose]
POSTGRES_USER=cofoundaz
POSTGRES_PASSWORD=CHANGE_ME__strong_random_password
POSTGRES_DB=cofoundaz

# Bootstrap admin account.                                              [app]
# Use a real mailbox you control; this is the account that recovers the others.
FIRST_SUPERUSER_EMAIL=admin@yourdomain.com
FIRST_SUPERUSER_PASSWORD=CHANGE_ME__strong_random_password

# -----------------------------------------------------------------------------
# 2. APPLICATION                                                        [app]
# -----------------------------------------------------------------------------
PROJECT_NAME=cofoundaz-api
VERSION=0.1.0
API_V1_STR=/api/v1

# Must be `production`. This is not cosmetic: app/core/logger.py drops the log
# level from DEBUG to INFO on any value other than `development`, and DEBUG logs
# request detail you do not want retained in production.
ENVIRONMENT=production

# Public origin, used to build links in outbound email (verification, password
# reset). Wrong value here = every emailed link points at the wrong host.
SERVER_HOST=https://api.yourdomain.com
SERVER_PORT=8000

# Empty = log to stderr only, so Docker's json-file driver collects and rotates.
# Leave it empty. A path here writes logs inside the container, where they are
# invisible to `docker logs` and lost on every deploy.
LOG_FILE_PATH=

# -----------------------------------------------------------------------------
# 3. AUTH / SESSION POSTURE                                             [app]
# -----------------------------------------------------------------------------
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_COOKIE_NAME=cfz_refresh

# MUST be True in production. False sends the refresh cookie over plain HTTP,
# where any network hop can read it and replay a 30-day session.
REFRESH_COOKIE_SECURE=True

# `lax` is correct when the frontend is on the same site as the API.
# If the frontend is on a DIFFERENT origin, this must be `none` - and `none`
# requires REFRESH_COOKIE_SECURE=True or browsers reject the cookie outright.
REFRESH_COOKIE_SAMESITE=lax

LOGIN_MAX_FAILS=5
LOGIN_LOCKOUT_MINUTES=15

# -----------------------------------------------------------------------------
# 4. CORS                                                               [app]
# -----------------------------------------------------------------------------
# Exact origins only. The app sends allow_credentials=True, so a wildcard is
# both rejected by browsers and a credential-theft vector. No trailing slashes.
BACKEND_CORS_ORIGINS=["https://app.yourdomain.com","https://yourdomain.com"]

# -----------------------------------------------------------------------------
# 5. DATABASE POOL                                                      [app]
# -----------------------------------------------------------------------------
# Per gunicorn worker, NOT per container. Total possible connections:
#   WEB_CONCURRENCY x (DATABASE_POOL_SIZE + DATABASE_MAX_OVERFLOW)
#   = 4 x (5 + 5) = 40, against POSTGRES_MAX_CONNECTIONS=100.
# Raise either of these and you MUST re-check that arithmetic, or the API will
# start failing with "FATAL: sorry, too many clients already" under load.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5

# -----------------------------------------------------------------------------
# 6. RATE LIMITING                                                      [app]
# -----------------------------------------------------------------------------
# Applied per authenticated user, falling back to client IP (app/main.py).
# NOTE: this is enforced per API *process* using slowapi's in-memory storage, so
# the effective global limit is roughly this x WEB_CONCURRENCY. Treat it as
# defence-in-depth behind nginx's own limit_req, not as an exact quota.
RATE_LIMIT_PER_MINUTE=120

# -----------------------------------------------------------------------------
# 7. EMAIL                                                              [app]
# -----------------------------------------------------------------------------
# smtp | console | file.  MUST be `smtp` in production - `console` silently
# discards verification and password-reset emails, so signup appears to work
# while no user can ever verify their address.
EMAIL_BACKEND=smtp
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
EMAILS_FROM_EMAIL=noreply@yourdomain.com
EMAILS_FROM_NAME=Cofoundaz

# -----------------------------------------------------------------------------
# 8. STORAGE                                                            [app]
# -----------------------------------------------------------------------------
STORAGE_BACKEND=local
# Backed by the `app_storage` named volume in docker-compose.prod.yml. The API
# container runs with a read-only root filesystem, so this path MUST stay inside
# a declared volume - anywhere else and uploads fail with EROFS.
LOCAL_STORAGE_DIR=./var/storage

# =============================================================================
# 9. COMPOSE-ONLY - infrastructure sizing and deployment            [compose]
# =============================================================================

# Image to run. CD sets this to an immutable sha tag; `latest` is a fallback for
# a manual first deploy only. Never leave production pinned to `latest` - you
# cannot tell what is running or roll back to a known-good build.
API_IMAGE=ghcr.io/innocent98/cofoundaz-api:sha-CHANGEME

# Provenance baked into the image / surfaced by /api/v1/health/ready.
GIT_SHA=unknown
APP_VERSION=0.1.0

# Host port. Bound to 127.0.0.1 by docker-compose.prod.yml; nginx proxies to it.
API_PORT=8000

# gunicorn worker count. Baseline is 4 for a 4 vCPU VPS. See the connection
# arithmetic in section 5 before changing.
WEB_CONCURRENCY=4

# --- Postgres tuning. Sized for the db service's 3072M limit. -----------------
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_SHARED_BUFFERS=768MB
POSTGRES_EFFECTIVE_CACHE_SIZE=2GB
POSTGRES_WORK_MEM=8MB
POSTGRES_MAINTENANCE_WORK_MEM=256MB

# --- Redis --------------------------------------------------------------------
# Deliberately below the redis service's 512M limit so Redis evicts by policy
# before the kernel OOM-kills it.
REDIS_MAXMEMORY=384mb
