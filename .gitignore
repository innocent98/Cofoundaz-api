# Environments
# Deny every .env variant, then re-allow the committed templates. A bare `.env`
# rule does NOT cover `.env.production` -- which is exactly the file that holds
# the production database password and SECRET_KEY.
.env
.env.*
!.env.example
!.env.production.example
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Poetry
# poetry.lock is INTENTIONALLY TRACKED: it is what makes container builds and CI
# reproducible. Do not re-ignore it.

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
logs/
*.log

# Database
*.db
*.sqlite
*.sqlite3

# Alembic
alembic/versions/*.pyc

