# Application
PROJECT_NAME=cofoundaz-api
VERSION=0.1.0
API_V1_STR=/api/v1
ENVIRONMENT=development

# Server
SERVER_HOST=http://localhost
SERVER_PORT=8000

# Security
# Generate your own -- do NOT ship or reuse a committed value:
#   openssl rand -hex 32
# The placeholder below is intentionally not a valid key so that copying this
# file without editing it fails loudly instead of silently signing every JWT in
# the project with a key that is public in git history.
SECRET_KEY=CHANGE_ME__run_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM=HS256

# TOTP secrets are encrypted at rest with this Fernet key.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Optional locally (MFA enrolment fails without it); REQUIRED and permanent in
# production -- see .env.production.example.
MFA_ENCRYPTION_KEY=

# Journal entries are encrypted at rest with this Fernet key.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Optional locally (journal writes fail without it). Not rotatable: losing it
# makes every existing journal entry permanently unreadable.
JOURNAL_ENCRYPTION_KEY=

# Session cookie posture. False is correct for local http:// development only.
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_COOKIE_NAME=cfz_refresh
REFRESH_COOKIE_SECURE=False
REFRESH_COOKIE_SAMESITE=lax
LOGIN_MAX_FAILS=5
LOGIN_LOCKOUT_MINUTES=15

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Database
# These URLs are for HOST-side use (running `make run`, alembic, or pytest on your
# machine) and must match the ports published by docker-compose (5432 / 6379).
# The API CONTAINER does NOT use these — docker-compose.yml overrides DATABASE_URL /
# REDIS_URL to the service names (db:5432 / redis:6379), because inside a container
# `localhost` is the container itself, not the sibling db/redis services.
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0

# Email (Optional)
SMTP_TLS=true
SMTP_PORT=587
SMTP_HOST=smtp.example.com
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-password
EMAILS_FROM_EMAIL=noreply@example.com
EMAILS_FROM_NAME=Your App Name

# Resend API key — required only when EMAIL_BACKEND=resend. Get one at
# https://resend.com; the From address comes from EMAILS_FROM_EMAIL/NAME above
# and must be on a Resend-verified domain.
RESEND_API_KEY=re_your_key_here

# Admin
FIRST_SUPERUSER_EMAIL=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# Test database used by pytest (tests/conftest.py). Must be a SEPARATE database
# from DATABASE_URL -- the suite drops and recreates every table in it.
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/cofoundaz_test

# Providers / local behaviour
# console | smtp | resend | file. `resend` uses RESEND_API_KEY (above). `file`
# writes captured emails to EMAIL_FILE_DIR, which is how scripts/e2e_run.sh reads
# one-time tokens back out.
EMAIL_BACKEND=console
EMAIL_FILE_DIR=./var/mail
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./var/storage
RATE_LIMIT_PER_MINUTE=120

# --- AI / LLM (Module 03 AI Co-Founder + the deferred AI features it unblocks:
#     Business Builder plan generator §08.11, health-score narrative, mission reason
#     lines, recommendation reasons, learning recs, validation insight synthesizer).
# Provider-agnostic scheme (the LLM seam switches on LLM_PROVIDER). Leave LLM_API_KEY
# empty to keep the AI features disabled/stubbed; set it to turn them on.
#   openai    → LLM_MODEL=gpt-4o-mini  · LLM_BASE_URL blank (uses OpenAI default)
#   anthropic → LLM_MODEL=claude-3-5-sonnet-latest · LLM_BASE_URL blank
#   azure / gateway / self-hosted (OpenAI-compatible) → set LLM_BASE_URL to the endpoint
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=

# Loguru file sink. Empty = stderr only (what containers want). The default
# below matches historical local behaviour.
LOG_FILE_PATH=logs/app.log
